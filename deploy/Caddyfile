{$PACHEVIDEO_DOMAIN} {
  encode zstd gzip

  @api path /api/*
  handle @api {
    reverse_proxy api:8080
  }

  handle {
    respond "PacheVideo API" 200
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    -Server
  }

  request_body {
    max_size 64KB
  }
}

